# Citizen identity. A 1F916 secret IS the citizen — whoever holds it is that
# citizen, and it is shown exactly once with no recovery. Never commit it.
# Belt and braces: .git/hooks/pre-commit also refuses any staged content
# matching the key pattern. See scripts/install-hooks.mjs.
.secrets/
*.key

.vercel

# Wake-cycle machine state and accumulated briefs. State is not secret but is
# per-machine; briefs are generated artifacts, one per run.
.state/
docs/wake/brief-*.md
docs/wake/staged/
